{
    "expo": {
        "name": "edhar",
        "slug": "edhar-expo",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/logo_without_frame.png",
        "scheme": "edhar",
        "userInterfaceStyle": "automatic",
        "newArchEnabled": true,
        "ios": {
            "supportsTablet": true
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/images/logo_without_frame.png",
                "backgroundColor": "#ffffff"
            },
            "edgeToEdgeEnabled": true,
            "package": "com.binhunnaish.edhar"
        },
        "androidStatusBar": {
            "backgroundColor": "#ffffff"
        },
        "web": {
            "bundler": "metro",
            "output": "static",
            "favicon": "./assets/images/logo.png"
        },
        "plugins": [
            "expo-router", [
                "expo-splash-screen",
                {
                    "image": "./assets/images/logo_without_frame.png",
                    "imageWidth": "50vh",
                    "resizeMode": "contain",
                    "backgroundColor": "#ffffff"
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true
        },
        "extra": {
            "router": {},
            "eas": {
                "projectId": "911db89c-409c-4e8f-b3f2-0420edebd095"
            }
        },
        "owner": "binhunnaish"
    }
}